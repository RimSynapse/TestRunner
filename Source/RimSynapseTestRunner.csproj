<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="GamePath.props" />

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <AssemblyName>RimSynapseTestRunner</AssemblyName>
        <RootNamespace>RimSynapse.TestRunner</RootNamespace>
        <LangVersion>9.0</LangVersion>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <OutputPath>..\Assemblies\</OutputPath>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <!-- RimWorld assemblies (not bundled — loaded at runtime) -->
    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.TextRenderingModule">
            <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <!-- RimSynapse Core: the tool registry under test. Core also ships Newtonsoft. -->
        <Reference Include="RimSynapseCore">
            <HintPath>$(RimSynapseCoreAssembly)\RimSynapseCore.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(RimSynapseCoreAssembly)\Newtonsoft.Json.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <!--
            Regions and Territories: residency and dwelling generation are under test. R&T does not
            reference Core and must keep working without it; the dependency runs one way, and this
            mod loads last, so referencing it here is safe.
        -->
        <Reference Include="RimSynapseRegionsAndTerritories">
            <HintPath>$(RimSynapseRegionsAssembly)\RimSynapseRegionsAndTerritories.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <!--
            Psychology: the daily-evaluation input split and lifetime-violence helpers (Stage 0 of the
            0.7.1 memory/eval redesign) are under test. Psychology depends on Core, not the other way
            round, and this mod loads last, so referencing it here keeps the one-way dependency intact.
        -->
        <Reference Include="RimSynapsePsychology">
            <HintPath>$(RimSynapsePsychologyAssembly)\RimSynapsePsychology.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <!--
            Harmony: EmpireIntegrationCases asks Harmony.GetPatchInfo which owners are attached to
            Empire's methods. A patch that never bound is indistinguishable from one that did unless
            something asks Harmony itself, and log scraping is not a substitute — Log.Messages is a
            bounded buffer.
        -->
        <Reference Include="0Harmony">
            <HintPath>$(HarmonyPath)\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- .NET Framework reference assemblies via NuGet: lets the build resolve net47x/net48
         from a restore, so only the .NET SDK is needed (no system-wide targeting pack). -->
    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

</Project>
